<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.9'>
  <world name='double_maze_world'>
    
    <!-- PLUGINS BASE DE FÍSICAS -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='ignition-gazebo-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='ignition-gazebo-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='ignition-gazebo-contact-system'/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- SOL Y LUZ -->
    <light name='sun' type='directional'>
      <pose>4 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- PLANO DEL SUELO -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- EL LABERINTO DOBLE (Dos cuartos interconectados) -->
    <model name='double_maze'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='maze_walls'>
        
        <!-- ================= PERÍMETRO EXTERIOR ================= -->
        <!-- Pared Norte (Abarca ambos cuartos, 16m largo) -->
        <collision name='wall_n_col'><pose>4 4 0.5 0 0 0</pose><geometry><box><size>16 0.2 1</size></box></geometry></collision>
        <visual name='wall_n_vis'><pose>4 4 0.5 0 0 0</pose><geometry><box><size>16 0.2 1</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material></visual>
        
        <!-- Pared Sur (Abarca ambos cuartos, 16m largo) -->
        <collision name='wall_s_col'><pose>4 -4 0.5 0 0 0</pose><geometry><box><size>16 0.2 1</size></box></geometry></collision>
        <visual name='wall_s_vis'><pose>4 -4 0.5 0 0 0</pose><geometry><box><size>16 0.2 1</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material></visual>

        <!-- Pared Oeste (Izquierda) -->
        <collision name='wall_w_col'><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.2 8 1</size></box></geometry></collision>
        <visual name='wall_w_vis'><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.2 8 1</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material></visual>

        <!-- Pared Este (Derecha) -->
        <collision name='wall_e_col'><pose>12 0 0.5 0 0 0</pose><geometry><box><size>0.2 8 1</size></box></geometry></collision>
        <visual name='wall_e_vis'><pose>12 0 0.5 0 0 0</pose><geometry><box><size>0.2 8 1</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material></visual>

        <!-- ================= PARED CENTRAL CON PUERTA ================= -->
        <!-- Segmento Superior de la pared divisoria -->
        <collision name='wall_mid_top_col'><pose>4 2.5 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry></collision>
        <visual name='wall_mid_top_vis'><pose>4 2.5 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry><material><ambient>0.2 0.8 0.5 1</ambient><diffuse>0.2 0.8 0.5 1</diffuse></material></visual>

        <!-- Segmento Inferior de la pared divisoria -->
        <collision name='wall_mid_bot_col'><pose>4 -2.5 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry></collision>
        <visual name='wall_mid_bot_vis'><pose>4 -2.5 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry><material><ambient>0.2 0.8 0.5 1</ambient><diffuse>0.2 0.8 0.5 1</diffuse></material></visual>
        <!-- NOTA: Queda una puerta de 2 metros en el centro (Y=-1 a Y=1) -->

        <!-- ================= OBSTÁCULOS CUARTO 1 (Izquierdo) ================= -->
        <collision name='obs_1a_col'><pose>-1.5 1.5 0.5 0 0 0</pose><geometry><box><size>3 0.2 1</size></box></geometry></collision>
        <visual name='obs_1a_vis'><pose>-1.5 1.5 0.5 0 0 0</pose><geometry><box><size>3 0.2 1</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>

        <collision name='obs_1b_col'><pose>1 -2 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry></collision>
        <visual name='obs_1b_vis'><pose>1 -2 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>

        <!-- ================= OBSTÁCULOS CUARTO 2 (Derecho) ================= -->
        <collision name='obs_2a_col'><pose>7.5 -1.5 0.5 0 0 0</pose><geometry><box><size>3 0.2 1</size></box></geometry></collision>
        <visual name='obs_2a_vis'><pose>7.5 -1.5 0.5 0 0 0</pose><geometry><box><size>3 0.2 1</size></box></geometry><material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.8 0.7 0.1 1</diffuse></material></visual>

        <collision name='obs_2b_col'><pose>10 2 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry></collision>
        <visual name='obs_2b_vis'><pose>10 2 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry><material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.8 0.7 0.1 1</diffuse></material></visual>

      </link>
    </model>

    <!-- MESA 1 (Cuarto Izquierdo) -->
    <model name='table_1'>
      <static>true</static>
      <pose>-2 -2 0 0 0 0</pose>
      <link name='table_parts'>
        <!-- Superficie -->
        <collision name='top_col'><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.5 1.0 0.05</size></box></geometry></collision>
        <visual name='top_vis'><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.5 1.0 0.05</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
        <!-- Patas -->
        <collision name='leg1_col'><pose>0.65 0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name='leg1_vis'><pose>0.65 0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name='leg2_col'><pose>-0.65 0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name='leg2_vis'><pose>-0.65 0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name='leg3_col'><pose>0.65 -0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name='leg3_vis'><pose>0.65 -0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name='leg4_col'><pose>-0.65 -0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name='leg4_vis'><pose>-0.65 -0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- MESA 2 (Cuarto Derecho) -->
    <model name='table_2'>
      <static>true</static>
      <pose>8 2 0 0 0 0</pose>
      <link name='table_parts'>
        <!-- Superficie -->
        <collision name='top_col'><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.5 1.0 0.05</size></box></geometry></collision>
        <visual name='top_vis'><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.5 1.0 0.05</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
        <!-- Patas -->
        <collision name='leg1_col'><pose>0.65 0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name='leg1_vis'><pose>0.65 0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name='leg2_col'><pose>-0.65 0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name='leg2_vis'><pose>-0.65 0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name='leg3_col'><pose>0.65 -0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name='leg3_vis'><pose>0.65 -0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name='leg4_col'><pose>-0.65 -0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name='leg4_vis'><pose>-0.65 -0.4 0.375 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>