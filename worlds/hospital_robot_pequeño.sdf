<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.9'>
  <world name='hospital_world_colored'>
    <!-- PLUGINS BASE DE FÍSICAS -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='ignition-gazebo-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='ignition-gazebo-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='ignition-gazebo-contact-system'/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- SOL Y LUZ -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- PLANO DEL SUELO -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- LETRERO "HOSPITAL"                         -->
    <!-- ========================================== -->
    <model name='hospital_sign'>
      <static>true</static>
      <!-- Posicionado a 2.5m de altura sobre el pasillo -->
      <pose>0 -1.5 2.5 0 0 0</pose>
      <link name='sign_link'>
        <!-- Tablero azul de fondo -->
        <visual name='board_vis'>
          <geometry><box><size>3.5 0.1 0.8</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material>
        </visual>
        <collision name='board_col'>
          <geometry><box><size>3.5 0.1 0.8</size></box></geometry>
        </collision>
        <!-- Letras en 3D -->
        <visual name='text_vis'>
          <!-- Rotado para que mire hacia el frente (cuarto amarillo) y desplazado ligeramente en Y para que resalte del tablero -->
          <pose>-1.4 -0.06 -0.2 1.5708 0 0</pose>
          <geometry>
            <text>
              <string>HOSPITAL</string>
            </text>
          </geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material> <!-- Letras Blancas -->
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- ESTRUCTURA DEL EDIFICIO (Paredes)          -->
    <!-- ========================================== -->
    <model name='building_structure'>
      <static>true</static>
      <link name='walls'>
        
        <!-- Pasadizo Principal (Paredes laterales) -->
        <visual name='corridor_wall_left'><pose>-6 0 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name='c_corridor_wall_left'><pose>-6 0 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry></collision>
        
        <visual name='corridor_wall_right'><pose>6 0 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name='c_corridor_wall_right'><pose>6 0 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry></collision>

        <!-- Pasadizo Principal (Pared Inferior dividida para puerta Amarilla) -->
        <visual name='corridor_wall_bottom_l'><pose>-3.25 -1.5 1 0 0 0</pose><geometry><box><size>5.5 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name='c_corridor_wall_bottom_l'><pose>-3.25 -1.5 1 0 0 0</pose><geometry><box><size>5.5 0.2 2</size></box></geometry></collision>
        
        <visual name='corridor_wall_bottom_r'><pose>3.25 -1.5 1 0 0 0</pose><geometry><box><size>5.5 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name='c_corridor_wall_bottom_r'><pose>3.25 -1.5 1 0 0 0</pose><geometry><box><size>5.5 0.2 2</size></box></geometry></collision>

        <!-- ========================================== -->
        <!-- CUARTO 1: VERDE (Izquierda) 3x3            -->
        <!-- ========================================== -->
        <visual name='r1_w1'><pose>-4.5 3 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
        <visual name='r1_w2'><pose>-1.5 3 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
        <visual name='r1_w3'><pose>-3 4.5 1 0 0 0</pose><geometry><box><size>3.2 0.2 2</size></box></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
        <visual name='r1_w4_part1'><pose>-3.75 1.5 1 0 0 0</pose><geometry><box><size>1.5 0.2 2</size></box></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
        <visual name='r1_w4_part2'><pose>-1.85 1.5 1 0 0 0</pose><geometry><box><size>0.7 0.2 2</size></box></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
        <!-- Colisiones -->
        <collision name='c_r1_w1'><pose>-4.5 3 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry></collision>
        <collision name='c_r1_w2'><pose>-1.5 3 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry></collision>
        <collision name='c_r1_w3'><pose>-3 4.5 1 0 0 0</pose><geometry><box><size>3.2 0.2 2</size></box></geometry></collision>
        <collision name='c_r1_w4_1'><pose>-3.75 1.5 1 0 0 0</pose><geometry><box><size>1.5 0.2 2</size></box></geometry></collision>
        <collision name='c_r1_w4_2'><pose>-1.85 1.5 1 0 0 0</pose><geometry><box><size>0.7 0.2 2</size></box></geometry></collision>

        <!-- ========================================== -->
        <!-- CUARTO 2: MORADO (Centro) 3x3              -->
        <!-- ========================================== -->
        <visual name='r2_w2'><pose>1.5 3 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry><material><ambient>0.6 0.2 0.8 1</ambient><diffuse>0.6 0.2 0.8 1</diffuse></material></visual>
        <visual name='r2_w3'><pose>0 4.5 1 0 0 0</pose><geometry><box><size>3.2 0.2 2</size></box></geometry><material><ambient>0.6 0.2 0.8 1</ambient><diffuse>0.6 0.2 0.8 1</diffuse></material></visual>
        <visual name='r2_w4_part1'><pose>-0.85 1.5 1 0 0 0</pose><geometry><box><size>1.3 0.2 2</size></box></geometry><material><ambient>0.6 0.2 0.8 1</ambient><diffuse>0.6 0.2 0.8 1</diffuse></material></visual>
        <visual name='r2_w4_part2'><pose>1.15 1.5 1 0 0 0</pose><geometry><box><size>0.9 0.2 2</size></box></geometry><material><ambient>0.6 0.2 0.8 1</ambient><diffuse>0.6 0.2 0.8 1</diffuse></material></visual>
        <!-- Colisiones -->
        <collision name='c_r2_w2'><pose>1.5 3 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry></collision>
        <collision name='c_r2_w3'><pose>0 4.5 1 0 0 0</pose><geometry><box><size>3.2 0.2 2</size></box></geometry></collision>
        <collision name='c_r2_w4_1'><pose>-0.85 1.5 1 0 0 0</pose><geometry><box><size>1.3 0.2 2</size></box></geometry></collision>
        <collision name='c_r2_w4_2'><pose>1.15 1.5 1 0 0 0</pose><geometry><box><size>0.9 0.2 2</size></box></geometry></collision>

        <!-- ========================================== -->
        <!-- CUARTO 3: ROJO (Derecha) 3x3               -->
        <!-- ========================================== -->
        <visual name='r3_w2'><pose>4.5 3 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
        <visual name='r3_w3'><pose>3 4.5 1 0 0 0</pose><geometry><box><size>3.2 0.2 2</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
        <visual name='r3_w4_part1'><pose>2.15 1.5 1 0 0 0</pose><geometry><box><size>1.1 0.2 2</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
        <visual name='r3_w4_part2'><pose>4.15 1.5 1 0 0 0</pose><geometry><box><size>0.9 0.2 2</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
        <!-- Colisiones -->
        <collision name='c_r3_w2'><pose>4.5 3 1 0 0 1.5708</pose><geometry><box><size>3 0.2 2</size></box></geometry></collision>
        <collision name='c_r3_w3'><pose>3 4.5 1 0 0 0</pose><geometry><box><size>3.2 0.2 2</size></box></geometry></collision>
        <collision name='c_r3_w4_1'><pose>2.15 1.5 1 0 0 0</pose><geometry><box><size>1.1 0.2 2</size></box></geometry></collision>
        <collision name='c_r3_w4_2'><pose>4.15 1.5 1 0 0 0</pose><geometry><box><size>0.9 0.2 2</size></box></geometry></collision>

        <!-- ========================================== -->
        <!-- CUARTO 4: AMARILLO (Frente/Grande) 6x4     -->
        <!-- ========================================== -->
        <!-- Pared Izquierda -->
        <visual name='r4_w1'><pose>-3 -3.5 1 0 0 1.5708</pose><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.1 1</ambient><diffuse>0.9 0.9 0.1 1</diffuse></material></visual>
        <collision name='c_r4_w1'><pose>-3 -3.5 1 0 0 1.5708</pose><geometry><box><size>4 0.2 2</size></box></geometry></collision>
        <!-- Pared Derecha -->
        <visual name='r4_w2'><pose>3 -3.5 1 0 0 1.5708</pose><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.1 1</ambient><diffuse>0.9 0.9 0.1 1</diffuse></material></visual>
        <collision name='c_r4_w2'><pose>3 -3.5 1 0 0 1.5708</pose><geometry><box><size>4 0.2 2</size></box></geometry></collision>
        <!-- Pared Inferior -->
        <visual name='r4_w3'><pose>0 -5.5 1 0 0 0</pose><geometry><box><size>6.2 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.1 1</ambient><diffuse>0.9 0.9 0.1 1</diffuse></material></visual>
        <collision name='c_r4_w3'><pose>0 -5.5 1 0 0 0</pose><geometry><box><size>6.2 0.2 2</size></box></geometry></collision>

      </link>
    </model>

    <!-- ========================================== -->
    <!-- MESA DE ATENCIÓN CON AGUJERO (Cuarto Morado)-->
    <!-- ========================================== -->
    <model name='custom_hole_desk'>
      <static>true</static>
      <pose>0 3 0 0 0 0</pose>
      <link name='desk_link'>
        <!-- Patas -->
        <visual name='leg1'><pose>0.9 0.4 0.45 0 0 0</pose><geometry><box><size>0.1 0.1 0.9</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name='leg2'><pose>-0.9 0.4 0.45 0 0 0</pose><geometry><box><size>0.1 0.1 0.9</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name='leg3'><pose>0.9 -0.4 0.45 0 0 0</pose><geometry><box><size>0.1 0.1 0.9</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name='leg4'><pose>-0.9 -0.4 0.45 0 0 0</pose><geometry><box><size>0.1 0.1 0.9</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        
        <!-- Tablero Hueco -->
        <visual name='top_front'><pose>0 0.45 0.95 0 0 0</pose><geometry><box><size>2.0 0.2 0.1</size></box></geometry><material><ambient>0.8 0.6 0.4 1</ambient><diffuse>0.8 0.6 0.4 1</diffuse></material></visual>
        <visual name='top_back'><pose>0 -0.45 0.95 0 0 0</pose><geometry><box><size>2.0 0.2 0.1</size></box></geometry><material><ambient>0.8 0.6 0.4 1</ambient><diffuse>0.8 0.6 0.4 1</diffuse></material></visual>
        <visual name='top_left'><pose>-0.9 0 0.95 0 0 0</pose><geometry><box><size>0.2 0.7 0.1</size></box></geometry><material><ambient>0.8 0.6 0.4 1</ambient><diffuse>0.8 0.6 0.4 1</diffuse></material></visual>
        <visual name='top_right'><pose>0.9 0 0.95 0 0 0</pose><geometry><box><size>0.2 0.7 0.1</size></box></geometry><material><ambient>0.8 0.6 0.4 1</ambient><diffuse>0.8 0.6 0.4 1</diffuse></material></visual>

        <!-- Colisiones -->
        <collision name='c_leg1'><pose>0.9 0.4 0.45 0 0 0</pose><geometry><box><size>0.1 0.1 0.9</size></box></geometry></collision>
        <collision name='c_leg2'><pose>-0.9 0.4 0.45 0 0 0</pose><geometry><box><size>0.1 0.1 0.9</size></box></geometry></collision>
        <collision name='c_leg3'><pose>0.9 -0.4 0.45 0 0 0</pose><geometry><box><size>0.1 0.1 0.9</size></box></geometry></collision>
        <collision name='c_leg4'><pose>-0.9 -0.4 0.45 0 0 0</pose><geometry><box><size>0.1 0.1 0.9</size></box></geometry></collision>
        <collision name='c_top_front'><pose>0 0.45 0.95 0 0 0</pose><geometry><box><size>2.0 0.2 0.1</size></box></geometry></collision>
        <collision name='c_top_back'><pose>0 -0.45 0.95 0 0 0</pose><geometry><box><size>2.0 0.2 0.1</size></box></geometry></collision>
        <collision name='c_top_left'><pose>-0.9 0 0.95 0 0 0</pose><geometry><box><size>0.2 0.7 0.1</size></box></geometry></collision>
        <collision name='c_top_right'><pose>0.9 0 0.95 0 0 0</pose><geometry><box><size>0.2 0.7 0.1</size></box></geometry></collision>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- ZONA DE RECARGA (Cuarto Verde)             -->
    <!-- ========================================== -->
    <model name='charging_dock'>
      <static>true</static>
      <pose>-3 3 0.05 0 0 0</pose>
      <link name='base'>
        <visual name='dock_visual'>
          <geometry><box><size>0.8 0.8 0.1</size></box></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
        <collision name='dock_collision'>
          <geometry><box><size>0.8 0.8 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- MESA Y ESTANTERÍA (Cuarto Rojo)            -->
    <!-- ========================================== -->
    <model name='bookshelf_simple'>
      <static>true</static>
      <pose>3 4 0 0 0 0</pose>
      <link name='link'>
        <visual name='visual'><pose>0 0 1 0 0 0</pose><geometry><box><size>1.5 0.4 2</size></box></geometry><material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material></visual>
        <collision name='collision'><pose>0 0 1 0 0 0</pose><geometry><box><size>1.5 0.4 2</size></box></geometry></collision>
      </link>
    </model>

    <model name='normal_table'>
      <static>true</static>
      <pose>3 2.5 0 0 0 0</pose>
      <link name='link'>
        <visual name='top'><pose>0 0 0.8 0 0 0</pose><geometry><box><size>1.5 0.8 0.05</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <visual name='leg'><pose>0 0 0.4 0 0 0</pose><geometry><box><size>0.2 0.2 0.8</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name='c_top'><pose>0 0 0.8 0 0 0</pose><geometry><box><size>1.5 0.8 0.05</size></box></geometry></collision>
        <collision name='c_leg'><pose>0 0 0.4 0 0 0</pose><geometry><box><size>0.2 0.2 0.8</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>